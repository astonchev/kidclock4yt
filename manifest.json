{
  "manifest_version": 3,
  "name": "Kid Clock for YouTube",
  "version": "1.0.0",
  "author": "astonchev",
  "description": "Allows watching m.youtube.com only during scheduled time slots; shows a clock otherwise.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://m.youtube.com/*"],
      "js": ["src/schedule.js", "src/clock.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kidclock4yt@astonchev.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
